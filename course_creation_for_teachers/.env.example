# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your local or API configuration if needed.
# NOTE: The core course engine runs 100% locally with zero paid API keys!
# =============================================================================

# Optional: Local LLM Endpoint (e.g. Ollama default is http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="mistral:instruct"

# Optional: Free-Tier Cloud Endpoints (No credit card required)
# GEMINI_API_KEY="your-gemini-free-tier-key-here"
# GROQ_API_KEY="your-groq-free-tier-key-here"

# Environment Mode
ENVIRONMENT="development"
DEBUG="false"
